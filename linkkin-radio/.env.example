# Radio streaming server — copy to .env and adjust for your host.
# Backend .env also has ICECAST_* and BROADCAST_GATEWAY_* settings.

ICECAST_PORT=8010
HLS_HTTP_PORT=8088
LISTENER_PROXY_PORT=8089

ICECAST_ADMIN_URL=http://127.0.0.1:8010
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me

ICECAST_SOURCE_PASSWORD=change-me
ICECAST_PUBLIC_URL=https://radio.linkkin.chat

BROADCAST_GATEWAY_PORT=8011
BROADCAST_GATEWAY_PUBLIC_HOST=radio.linkkin.chat
BROADCAST_GATEWAY_PUBLIC_PORT=2001
